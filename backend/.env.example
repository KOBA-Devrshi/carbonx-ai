# --- Database ---
# Defaults to a local SQLite file if unset (fine for the ideathon demo).
# For real Postgres: postgresql+psycopg2://user:password@localhost:5432/carbonx
DATABASE_URL=sqlite:///./carbonx.db

# --- AI ---
# Optional. If unset, ai_audit.py falls back to deterministic template-
# based explanations. Nothing crashes without this.
#
# OPTION A — OpenAI directly (paid, no free tier for most accounts)
#   OPENAI_API_KEY=sk-...
#   OPENAI_MODEL=gpt-4o-mini
#   (leave OPENAI_BASE_URL unset)
#
# OPTION B — Google Gemini, via its OpenAI-compatible endpoint (free tier)
#   OPENAI_API_KEY=<your Gemini API key>
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   OPENAI_MODEL=gemini-2.5-flash
#
# OPTION C — Groq, fast inference on open models (free tier)
#   OPENAI_API_KEY=<your Groq API key>
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
#
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Blockchain (Polygon testnet) ---
# Optional. If any of these are unset, blockchain.py runs in Demo Mode.
POLYGON_RPC_URL=
POLYGON_PRIVATE_KEY=
CARBON_DNA_CONTRACT_ADDRESS=

# --- App ---
APP_MODE=DEMO
CORS_ORIGINS=http://localhost:3000